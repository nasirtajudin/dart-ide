<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/vs_editor_bg">

    <!-- VS Code-style title bar (top padding = status bar inset, applied in code) -->
    <LinearLayout
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/vs_bar"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_topbar_folder"
            app:tint="@color/vs_accent"
            android:contentDescription="@string/title_bar_title" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/title_bar_title"
            android:textColor="@color/vs_text"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <TextView
            android:id="@+id/run_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_run_pill"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/run_label"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <ImageView
            android:id="@+id/kebab_button"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="12dp"
            android:src="@drawable/ic_kebab"
            app:tint="@color/vs_text_dim"
            android:contentDescription="@string/toast_coming_soon" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/vs_bar" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- iOS-style floating tab bar (bottom padding = nav bar inset, applied in code) -->
    <FrameLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:minHeight="56dp"
            android:background="@drawable/bg_bottom_bar"
            android:elevation="6dp">

            <LinearLayout
                android:id="@+id/tab_code"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/tab_code_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_nav_code"
                    android:contentDescription="@string/tab_code" />

                <TextView
                    android:id="@+id/tab_code_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/tab_code"
                    android:textSize="10sp"
                    android:letterSpacing="0.02" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tab_preview"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/tab_preview_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_nav_preview"
                    android:contentDescription="@string/tab_preview" />

                <TextView
                    android:id="@+id/tab_preview_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/tab_preview"
                    android:textSize="10sp"
                    android:letterSpacing="0.02" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tab_settings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/tab_settings_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_nav_settings"
                    android:contentDescription="@string/tab_settings" />

                <TextView
                    android:id="@+id/tab_settings_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/tab_settings"
                    android:textSize="10sp"
                    android:letterSpacing="0.02" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
