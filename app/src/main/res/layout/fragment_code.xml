<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/vs_editor_bg">

    <!-- Editor tab strip (tabs are built by CodeFragment) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="@color/vs_panel"
        android:scrollbars="none"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/editor_tabs"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/vs_bar" />

    <!-- Editor surface: sora CodeEditor is added here by CodeFragment -->
    <FrameLayout
        android:id="@+id/editor_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Collapsible console drawer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/vs_border" />

        <LinearLayout
            android:id="@+id/console_header"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/vs_panel"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_console"
                app:tint="@color/vs_text_dim"
                android:contentDescription="@string/console_label" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/console_label"
                android:textColor="@color/vs_text_dim"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/console_status"
                android:layout_marginStart="8dp"
                android:text="@string/console_waiting"
                android:textColor="@color/vs_text_dim"
                android:textSize="11sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/console_chevron"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:clickable="false"
                android:src="@drawable/ic_chevron"
                app:tint="@color/vs_text_dim"
                android:contentDescription="@string/console_toggle" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/console_body"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:orientation="vertical"
            android:background="@color/vs_editor_bg"
            android:visibility="gone">

            <ScrollView
                android:id="@+id/console_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/console_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jetbrains_mono"
                    android:padding="10dp"
                    android:text="@string/console_empty"
                    android:textColor="@color/vs_text_dim"
                    android:textSize="12sp" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
